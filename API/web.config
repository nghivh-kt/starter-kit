<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình IIS cho site. "dotnet publish" tự thêm phần ASP.NET Core Module (handlers, aspNetCore) vào file này.
  Header bảo mật khác (CSP, nosniff...) do app tự thêm: xem Startup/ClientAppConfiguration.cs.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <security>
        <!-- Không lộ phiên bản IIS qua header "Server" (IIS 10 trở lên) -->
        <requestFiltering removeServerHeader="true" />
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
